# ---- AI providers (self-hosting ke liye) ----
# Add as many as you want — they're tried in this order as an automatic
# fallback chain: Groq -> Gemini -> NVIDIA -> OpenRouter -> Cerebras -> OpenAI.
# Only providers with a key set below are used. If a provider fails
# (rate limit, downtime, bad model id, etc.) the next one is tried
# automatically — the app works fine with just ONE key configured.

# 1) Groq (fast + generous free tier) -> https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# 2) Google Gemini (free tier available) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 3) NVIDIA NIM (free API credits) -> https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# 4) OpenRouter (has free ":free" models) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 5) Cerebras (fast inference, free tier) -> https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# 6) OpenAI (paid) -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Lovable pe chalate waqt yeh apne aap set hota hai (manually mat daalo)
# Used only for voice transcription (/api/transcribe) and text-to-speech (/api/speak).
# LOVABLE_API_KEY=
